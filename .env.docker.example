# Copy this file to .env.docker and fill in real values before running
# `docker compose up`. docker-compose.yml overrides MONGO_URI itself (to
# point at the `mongo` service), so you don't need to set it here for local
# Docker use — only for running the API outside Docker (see backend/README.md).

APP_NAME=TechMart Support AI
ENVIRONMENT=development
LOG_LEVEL=INFO

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

MONGO_DB_NAME=techmart_support

# Required for the chat/RAG endpoints to work — get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

RATE_LIMIT_DEFAULT=60/minute
ACTIVE_ROUTER=rule_based

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Leave blank for local dev (any username/password works, matching the
# original Milestone 1 stub). Generate a real one for anything you expose
# publicly: python -m scripts.generate_password_hash
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH=
